<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <link>${_xml_baseurl}feed.xml</link>
    <title>$!_xml_title</title>
    <description>$!_xml_description</description>
    <lastBuildDate>$!_xml_updated</lastBuildDate>
		<atom:link href="${_xml_baseurl}feed.xml" rel="self" type="application/rss+xml" />
	  #foreach($_entry in $entries)
    <item>
      <guid isPermaLink="true">$!_entry.xml_id</guid>
      <title>$!_entry.xml_title</title>
      <description>$!_entry.xml_body</description>
  	  <link>$!_entry.xml_url</link>
      <pubDate>$!_entry.xml_created</pubDate>
    </item>
	  #end
  </channel>
</rss>